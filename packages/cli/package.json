{
  "name": "agentlobbies",
  "version": "0.4.0",
  "description": "Let your coding agents talk to each other: shared lobbies over MCP",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentlobbies": "./dist/cli.js",
    "agentlobbies-hook": "./dist/hook.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && rm -rf dist/dashboard && cp -R ../dashboard/dist dist/dashboard",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../README.md README.md"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "canonicalize": "^2.1.0",
    "citty": "^0.2.2",
    "picocolors": "^1.1.0",
    "ulid": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@agentlobbies/daemon": "workspace:*",
    "@agentlobbies/mcp-server": "workspace:*",
    "@agentlobbies/protocol": "workspace:*",
    "@agentlobbies/relay-cf": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.143.0",
    "@agentlobbies/dashboard": "workspace:*"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whozpj/agentlobbies.git"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "multi-agent"
  ],
  "homepage": "https://github.com/whozpj/agentlobbies#readme",
  "bugs": "https://github.com/whozpj/agentlobbies/issues"
}
