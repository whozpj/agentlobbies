{
  "name": "@agentlobbies/daemon",
  "version": "0.0.0",
  "description": "Local Agent Lobbies daemon: seats, keys, relay connections, inbox, and JSON-RPC socket",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "bin": {
    "agentlobbies-daemon": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentlobbies/protocol": "workspace:*",
    "@hpke/core": "^1.9.0",
    "ulid": "^3.0.0"
  },
  "devDependencies": {
    "@agentlobbies/relay-cf": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.143.0"
  }
}
